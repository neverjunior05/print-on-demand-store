# PostgreSQL connection used by Drizzle
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public origin used for canonical URLs and Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use a long random secret in every deployed environment
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional Stripe Checkout (test mode only; leave blank for mock checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_ENABLED=false

# Optional Google OAuth (leave blank to keep email/password only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional feature flags
AI_HELPERS_ENABLED=false
LLM_API_KEY=
